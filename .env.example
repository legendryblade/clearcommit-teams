# ClearCommit Teams — environment template.
# Copy to .env (never commit it) and fill in only what you have.
#
# With none of these set, the server runs in DEMO mode: a real networked
# multi-user backend with server-issued demo credentials and a local database.
# Demo mode is labeled as such everywhere in the UI and must not be presented
# as real multi-user authentication.

# ---- Supabase mode (both required to leave demo mode) ----
# CLEARCOMMIT_SUPABASE_URL=https://your-project.supabase.co
# CLEARCOMMIT_SUPABASE_ANON_KEY=<public anon key, safe for the client>
# CLEARCOMMIT_DATABASE_URL=postgresql+psycopg://postgres:<password>@db.your-project.supabase.co:5432/postgres
# Verify tokens with either the project JWT secret or the JWKS endpoint.
# CLEARCOMMIT_SUPABASE_JWT_SECRET=
# CLEARCOMMIT_SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# ---- Deployment (required for a public API) ----
# Comma-separated exact origins allowed to call this API. '*' is refused.
# CLEARCOMMIT_ALLOWED_ORIGINS=https://app.yourdomain.com

# ---- Server tuning (optional) ----
# CLEARCOMMIT_SERVER_HOST=127.0.0.1
# CLEARCOMMIT_SERVER_PORT=8770
# CLEARCOMMIT_SERVER_DATA_DIR=server_data
# CLEARCOMMIT_TOKEN_TTL_MINUTES=720
# CLEARCOMMIT_REQUEST_TIMEOUT_SECONDS=15
# CLEARCOMMIT_RATE_LIMIT_PER_MINUTE=120

# ---- Desktop client (optional) ----
# CLEARCOMMIT_SERVER_URL=http://127.0.0.1:8770

# ---- Desktop live capture and voice (optional) ----
# Without a key the app still runs; capture records and the panel says why it
# cannot transcribe. These are read by the desktop app, never sent anywhere.
# GROQ_API_KEY=                      # Whisper transcription (default provider)
# DEEPGRAM_API_KEY=                  # adds speaker separation
# ELEVENLABS_API_KEY=                # natural voice for interpretation
# ELEVENLABS_VOICE_ID=               # defaults to Sarah
#
# Model overrides. Blank or unset uses the accurate defaults shown; they can
# also be changed in Workspace settings inside the app.
# CLEARCOMMIT_STT_MODEL_GROQ=whisper-large-v3
# CLEARCOMMIT_STT_MODEL_DEEPGRAM=nova-3
# CLEARCOMMIT_TTS_MODEL=eleven_turbo_v2_5
